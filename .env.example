DATABASE_URL=postgres://postgres:postgres@localhost:5432/seats
CACHE_URL=redis://localhost:6379
JWT_SECRET=dev-secret-change-me
AUTH_TOKEN_ROUTE_ENABLED=true
DB_POOL_MAX_CONNECTIONS=30
DB_ACQUIRE_TIMEOUT_SECS=5
RESERVE_SEMAPHORE_PERMITS=24
RESERVE_QUEUE_TIMEOUT_SECS=15
DB_STATEMENT_TIMEOUT_SECS=5
PORT=8080

