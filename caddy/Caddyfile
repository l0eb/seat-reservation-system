# Local load balancer for the three api replicas (docker compose). The
# deployed edge uses the same block, with a real hostname for TLS.
:8080 {
	encode zstd gzip
	reverse_proxy api-1:8080 api-2:8080 api-3:8080 {
		# Each request goes to the replica with the fewest in flight.
		lb_policy least_conn
		# Active checks: a replica whose /readyz fails (e.g. it lost the
		# database) stops getting traffic within ~2s.
		health_uri /readyz
		health_interval 2s
		health_timeout 1s
		# A replica that refuses connections is skipped; Caddy retries only
		# requests it never managed to send, so nothing is sent twice.
		lb_try_duration 2s
		fail_duration 10s
	}
}
